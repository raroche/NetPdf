<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Console-app benchmark host (BenchmarkDotNet). Not a unit-test project, so does not
    set IsTestProject (which would make `dotnet test` try to run it via testhost).
    Inherits AOT-compat / packing flags overrides directly so the project still opts
    out of trim/AOT analysis and packing.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFrameworks>net10.0</TargetFrameworks>
    <RootNamespace>NetPdf.Benchmarks</RootNamespace>
    <AssemblyName>NetPdf.Benchmarks</AssemblyName>
    <IsAotCompatible>false</IsAotCompatible>
    <IsTrimmable>false</IsTrimmable>
    <EnableTrimAnalyzer>false</EnableTrimAnalyzer>
    <IsPackable>false</IsPackable>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
    <IncludeSymbols>false</IncludeSymbols>
    <!--
      Pin Workstation GC + concurrent collection. The committed baseline numbers
      were captured under Workstation GC; Server GC (the .NET default for headless
      / containerized hosts) produces measurably different allocation and timing
      profiles, which would invalidate the committed baselines.
    -->
    <ServerGarbageCollection>false</ServerGarbageCollection>
    <ConcurrentGarbageCollection>true</ConcurrentGarbageCollection>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\NetPdf\NetPdf.csproj" />
    <!--
      Direct reference to NetPdf.Pdf is required for Phase 1 because the benchmark
      suite measures the byte-writer path that hasn't yet been wired through the
      public HtmlPdf.Convert facade (Phase 2). NetPdf.Pdf already grants
      InternalsVisibleTo("NetPdf.Benchmarks") for this.
    -->
    <ProjectReference Include="..\..\src\NetPdf.Pdf\NetPdf.Pdf.csproj" />
    <!--
      TestKit owns the shared minimal image fixtures (MinimalImageFixtures,
      MinimalPngFixtures). Single source of truth for hand-crafted JPEG / GIF /
      PNG bytes plus the SkiaSharp WebP encoder used by the raster benchmarks.
      Replaces inline fixture duplication in PdfWriteBenchmarks.cs.
    -->
    <ProjectReference Include="..\NetPdf.TestKit\NetPdf.TestKit.csproj" />
    <!--
      Phase 2 pipeline benchmarks consume internal types (`Phase2Result`,
      `Box`, `BoxKind`) through transitive InternalsVisibleTo grants on
      NetPdf.Css + NetPdf.Layout to NetPdf.Benchmarks.
    -->
    <ProjectReference Include="..\..\src\NetPdf.Css\NetPdf.Css.csproj" />
    <ProjectReference Include="..\..\src\NetPdf.Layout\NetPdf.Layout.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
  </ItemGroup>

  <!--
    Keep BenchmarkDotNet's GENERATED job projects out of the repo's MSBuild/NuGet inheritance.

    At run time BDN writes a per-job project to `$(TargetDir)<guid>/BenchmarkDotNet.Autogenerated.csproj`
    and restores it — the SAME directory the sentinels below are written to, which is what puts them on
    the generated project's upward-search path. ($(TargetDir) is just the absolute form of $(OutDir);
    this comment and the target both say $(TargetDir) so the two cannot drift apart, and because only
    the absolute form is safe to use in the target — see the note on it below.)
    That path is inside the repo, so MSBuild and NuGet walk UP from it and pick up the
    root `Directory.Build.props` + `Directory.Packages.props` — meaning the generated project inherits
    Central Package Management (including CentralPackageTransitivePinningEnabled). On the CI runner that
    made restore try to resolve the generated assembly name — a GUID — as a NuGet package:

        error NU1101: Unable to find package e0917db2-1744-4b6e-a1dc-bc1266567f06

    Only 3 of 33 benchmarks survived, and the gate then compared that partial result set and crashed, so
    the perf gate had effectively stopped measuring anything (it did NOT reproduce on a dev box — the
    failure is specific to the CI restore environment).

    Dropping inert sentinels in `$(TargetDir)` stops the upward search BELOW the repo root, so the
    generated project restores standalone with CPM off. These live in `bin/` (gitignored) and are
    rewritten on every build, so there is nothing to keep in sync. They cannot affect this project or any
    other: MSBuild only searches upward from a project's OWN directory, and nothing but BDN's generated
    code builds under `bin/`. `scripts/benchmark-gate.sh` fails loudly if the generated project ever
    breaks again.
  -->
  <Target Name="IsolateBenchmarkDotNetGeneratedProjects" AfterTargets="Build"
          Condition="'$(TargetFramework)' != ''">
    <!--
      Two traps, both of which write the sentinels NEXT TO this .csproj instead of under bin/ —
      and a Directory.Packages.props beside the project turns CPM off for the project ITSELF, so
      its version-less BenchmarkDotNet reference then fails with NU1015:
        1. Use $(TargetDir) (absolute), NOT $(OutDir) (relative) — WriteLinesToFile resolves a
           relative path against the working directory.
        2. Condition on $(TargetFramework): `<TargetFrameworks>` (plural) runs an OUTER build with
           no TFM where $(TargetDir) is EMPTY, so the path collapses to a bare filename.
    -->
    <WriteLinesToFile File="$(TargetDir)Directory.Build.props"
                      Lines="&lt;Project /&gt;" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(TargetDir)Directory.Build.targets"
                      Lines="&lt;Project /&gt;" Overwrite="true" WriteOnlyWhenDifferent="true" />
    <WriteLinesToFile File="$(TargetDir)Directory.Packages.props"
                      Lines="&lt;Project&gt;&lt;PropertyGroup&gt;&lt;ManagePackageVersionsCentrally&gt;false&lt;/ManagePackageVersionsCentrally&gt;&lt;/PropertyGroup&gt;&lt;/Project&gt;"
                      Overwrite="true" WriteOnlyWhenDifferent="true" />
  </Target>

</Project>
